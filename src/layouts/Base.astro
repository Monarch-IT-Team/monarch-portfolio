---
import '@fontsource-variable/jost';
import '@fontsource-variable/unbounded';
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { SITE } from '../config';

interface Props {
  title: string;
  description: string;
  /** The first-visit intro (main page only). */
  intro?: boolean;
  noindex?: boolean;
}
const { title, description, intro = true, noindex = false } = Astro.props;
const gaId: string = import.meta.env.PUBLIC_GA_ID || SITE.gaId;
const base = import.meta.env.BASE_URL.replace(/[/]$/, '');
const og = new URL(`${base}/og.jpg`, SITE.url).href;

// Runs before the first paint: intro on the first visit only, lite mode (no 3D) if chosen before.
// If the main script never runs, everything is revealed after 4 s.
const introCheck = intro
  ? `var rm=window.matchMedia('(prefers-reduced-motion: reduce)').matches;var seen=localStorage.getItem('mx-intro');if(!rm&&!seen&&!/[?&]nointro\\b/.test(location.search))d.classList.add('mx-intro');`
  : '';
const boot = `(function(){var d=document.documentElement;d.classList.add('js');try{if(localStorage.getItem('mx-lite')==='1')d.classList.add('mx-lite');${introCheck}}catch(e){}setTimeout(function(){if(!d.classList.contains('ready')){d.classList.add('no-anim');d.classList.remove('mx-intro');}},4000);})();`;
const ga = `window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments);};gtag('js',new Date());gtag('config',${JSON.stringify(gaId)});`;
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#03040a" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={`${SITE.url}${base}/`} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${SITE.url}${base}/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline set:html={boot} />
    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline set:html={ga} />
        </>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
