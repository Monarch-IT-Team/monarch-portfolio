---
// Shows public/photo/portrait.(jpg|jpeg|png|webp|avif) if it exists at build time,
// otherwise a generated orb with the Monexarch constellation.
import fs from 'node:fs';
import path from 'node:path';
import Logo from './Logo.astro';

const dir = path.resolve('public/photo');
const photo = ['jpg', 'jpeg', 'png', 'webp', 'avif']
  .map((ext) => `portrait.${ext}`)
  .find((file) => fs.existsSync(path.join(dir, file)));

// A few fixed specks of starlight inside the orb.
const specks = [
  [52, 44, 0.9, 0.7], [104, 52, 0.7, 0.5], [118, 96, 1, 0.6], [46, 108, 0.8, 0.45],
  [70, 122, 0.6, 0.5], [96, 118, 0.9, 0.55], [60, 62, 0.5, 0.4], [112, 72, 0.6, 0.5],
  [40, 82, 0.6, 0.35], [86, 36, 0.7, 0.5],
];
---

<div class="avatar">
  {
    photo ? (
      <img src={`${import.meta.env.BASE_URL.replace(/[/]$/, '')}/photo/${photo}`} alt="Muhammadamin Gulomov" width="168" height="168" loading="lazy" decoding="async" />
    ) : (
      <svg viewBox="0 0 160 160" role="img" aria-label="Monexarch">
        <defs>
          <radialGradient id="av-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0.72" stop-color="#b57bff" stop-opacity="0.22" />
            <stop offset="1" stop-color="#b57bff" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="av-body" cx="36%" cy="28%" r="82%">
            <stop offset="0" stop-color="#1c2244" />
            <stop offset="0.55" stop-color="#0a0d1c" />
            <stop offset="1" stop-color="#04050b" />
          </radialGradient>
          <linearGradient id="av-rim" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#e8d6ff" stop-opacity="0.95" />
            <stop offset="0.45" stop-color="#b57bff" stop-opacity="0.25" />
            <stop offset="1" stop-color="#b57bff" stop-opacity="0" />
          </linearGradient>
          <clipPath id="av-clip">
            <circle cx="80" cy="80" r="62" />
          </clipPath>
        </defs>
        <circle cx="80" cy="80" r="80" fill="url(#av-glow)" />
        <circle cx="80" cy="80" r="62" fill="url(#av-body)" />
        <g clip-path="url(#av-clip)" fill="#fff">
          {specks.map(([x, y, r, o]) => (
            <circle cx={x} cy={y} r={r} opacity={o} />
          ))}
        </g>
        <circle cx="80" cy="80" r="62" fill="none" stroke="url(#av-rim)" stroke-width="1.3" />
        <ellipse
          cx="80"
          cy="80"
          rx="77"
          ry="19"
          transform="rotate(-18 80 80)"
          fill="none"
          stroke="#b57bff"
          stroke-opacity="0.35"
          stroke-width="0.8"
        />
        <g transform="translate(80 80) scale(1.55) translate(-24 -23)" color="#c79bff">
          <Logo inner />
        </g>
      </svg>
    )
  }
</div>
