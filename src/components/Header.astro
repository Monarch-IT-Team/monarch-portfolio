---
import Logo from './Logo.astro';
interface Props {
  t: (key: string) => string;
}
const { t } = Astro.props;
---

<header class="header">
  <a class="brand" href="#hero" aria-label={t('ui.home')} data-i18n-attr="aria-label:ui.home">
    <Logo class="brand__mark" size={30} />
    <span class="brand__word">Monexarch</span>
  </a>

  <div class="readout" aria-hidden="true">
    <span class="readout__val">1.0 × 10⁹</span>
    <span class="readout__unit" data-i18n="rail.unit">{t('rail.unit')}</span>
    <span class="readout__sep">·</span>
    <span class="readout__name">{t('rail.l0')}</span>
  </div>

  <div class="controls">
    <button
      class="ctl ctl--sound"
      type="button"
      data-sound-btn
      aria-pressed="false"
      aria-label={t('ui.sound')}
      data-i18n-attr="aria-label:ui.sound;title:ui.sound"
      title={t('ui.sound')}
    >
      <span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    </button>
    <button
      class="ctl ctl--3d"
      type="button"
      data-three-btn
      aria-pressed="true"
      aria-label={t('ui.lite')}
      data-i18n-attr="aria-label:ui.lite;title:ui.lite"
      title={t('ui.lite')}
    >
      3D
    </button>
    <span class="controls__sep" aria-hidden="true"></span>
    <nav class="langs" aria-label={t('ui.lang')} data-i18n-attr="aria-label:ui.lang">
      <button type="button" lang="uz" data-lang-btn="uz" aria-pressed="false">UZ</button>
      <button type="button" lang="ru" data-lang-btn="ru" aria-pressed="false">RU</button>
      <button type="button" lang="en" data-lang-btn="en" aria-pressed="true">EN</button>
    </nav>
  </div>
</header>
